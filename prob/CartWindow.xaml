<Window x:Class="prob.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="610" Width="850"
        Icon="Images/icon/Чудо Обувь.ico"
        WindowStartupLocation="CenterOwner" Language="ru-RU"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="#D2F6E7">
            <TextBlock Text="Ваш заказ" FontSize="24" VerticalAlignment="Center" Margin="15,0,0,0" />
        </Grid>

        <DataGrid x:Name="gridCart" Grid.Row="1" Margin="10" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="80" />
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100" />
                <DataGridTextColumn Header="Цена за единицу" Binding="{Binding PriceText}" Width="140" />
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalText}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="10">
            <StackPanel x:Name="panelClient" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Клиент:" VerticalAlignment="Center" />
                <ComboBox x:Name="comboClients" Width="260" Height="28" Margin="8,0,15,0"
                          VerticalContentAlignment="Center" />
                <TextBlock Text="Дата заказа:" VerticalAlignment="Center" />
                <DatePicker x:Name="datePickerOrder" Width="130" Height="28" Margin="8,0,0,0"
                            VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="textTotal" FontSize="20" HorizontalAlignment="Right" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Новое количество:" VerticalAlignment="Center" />
                <TextBox x:Name="textNewQuantity" Width="60" Height="26" Margin="8,0,8,0" MaxLength="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Button Content="Изменить количество" Width="160" Height="30" Click="ButtonChangeQuantity_Click" />
                <Button Content="Удалить позицию" Width="140" Height="30" Margin="8,0,0,0"
                        Click="ButtonDelete_Click" />
            </StackPanel>
            <TextBlock x:Name="textHint" Foreground="Red" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button Content="Подтвердить заказ" Width="160" Height="34" Background="#70B2AF"
                        Click="ButtonConfirm_Click" />
                <Button Content="Отказаться от заказа" Width="160" Height="34" Margin="8,0,0,0"
                        Click="ButtonCancelOrder_Click" />
                <Button Content="Назад" Width="90" Height="34" Margin="8,0,0,0" Click="ButtonBack_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>