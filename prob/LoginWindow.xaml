<Window x:Class="prob.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="390" Width="400"
        Icon="Images/icon/Чудо Обувь.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" FontSize="14" Background="#D2F6E7">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="40,69,40,71" Grid.RowSpan="2">
            <TextBlock Text="Вход в систему" FontSize="22" HorizontalAlignment="Center" />
            <TextBlock Text="Логин" Margin="0,20,0,3" />
            <TextBox x:Name="textLogin" MaxLength="50" Height="34" FontSize="16" VerticalContentAlignment="Center"/>
            <Button Content="Войти" Margin="0,20,0,0" Height="34" Background="#70B2AF" IsDefault="True" Click="ButtonLogin_Click" />
            <Button Content="Войти как неавторизованный пользователь" Margin="0,10,0,0" Height="34" Click="ButtonGuest_Click" />
        </StackPanel>
    </Grid>
</Window>