<Window x:Class="prob.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="700" Width="1000" MinWidth="1000"
        Icon="Images/icon/Чудо Обувь.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Background="#D2F6E7">
            <Image Source="Images/icon/Чудо Обувь.png" HorizontalAlignment="Left" Margin="10" Stretch="Uniform" />
            <TextBlock Text="Каталог обуви" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock x:Name="textUserName" FontSize="16" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,8,15,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="labelSearch" Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" />
            <TextBox x:Name="textSearch" Grid.Column="1" Width="150" Height="28" Margin="5,0,15,0"
                     VerticalContentAlignment="Center" TextChanged="TextSearch_TextChanged" />

            <TextBlock x:Name="labelSort" Grid.Column="2" Text="Сортировка:" VerticalAlignment="Center" />
            <ComboBox x:Name="comboSort" Grid.Column="3" Width="160" Height="28" Margin="5,0,15,0"
                      VerticalContentAlignment="Center" SelectedIndex="0"
                      SelectionChanged="ComboSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" />
                <ComboBoxItem Content="Цена по возрастанию" />
                <ComboBoxItem Content="Цена по убыванию" />
            </ComboBox>

            <TextBlock x:Name="labelCategory" Grid.Column="4" Text="Категория:" VerticalAlignment="Center" />
            <ComboBox x:Name="comboCategory" Grid.Column="5" Width="130" Height="28" Margin="5,0,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="ComboCategory_SelectionChanged" />

            <Button x:Name="buttonManageOrders" Grid.Column="7" Content="Заказы" Width="90" Height="30"
                    Margin="0,0,8,0" Click="ButtonManageOrders_Click" />
            <Button x:Name="buttonOrder" Grid.Column="8" Content="Мой заказ (0)" Width="120" Height="30"
                    Background="#70B2AF" Click="ButtonOrder_Click" />
            <Button Grid.Column="9" Content="Выйти" Width="70" Height="30" Margin="8,0,0,0"
                    Click="ButtonExit_Click" />
        </Grid>

        <ListBox x:Name="listProducts" Grid.Row="2" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ListProducts_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="{Binding Background}">
                        <Grid MinHeight="110">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Photo}" Margin="5" />

                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="{Binding Title}" FontSize="18" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Category}" />
                                <TextBlock Text="{Binding Quantity}" />
                                <TextBlock Text="{Binding Composition}" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Price}" FontSize="20" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="textEmpty" Grid.Row="2" Text="Товары не найдены" FontSize="18"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
    </Grid>
</Window>