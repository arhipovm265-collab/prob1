<Window x:Class="prob.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="650" Width="950"
        Icon="Images/icon/Чудо Обувь.ico"
        WindowStartupLocation="CenterOwner" Language="ru-RU"
        FontFamily="Calibri" FontSize="14" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Background="#D2F6E7">
            <TextBlock Text="Состав заказа" FontSize="24" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Grid>

        <TextBlock x:Name="textOrderInfo" Grid.Row="1" FontSize="16" TextWrapping="Wrap"  Margin="10,10,10,0"/>

        <DataGrid x:Name="gridLines" Grid.Row="2" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товарная позиция" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="80"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Цена за единицу" Binding="{Binding PriceText}" Width="140"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="10">

            <TextBlock x:Name="textTotal" FontSize="20" HorizontalAlignment="Right"/>

            <StackPanel x:Name="panelEdit" Margin="0,10,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Дата заказа:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="datePickerOrder" Width="130" Height="28" Margin="8,0,8,0"/>
                    <Button Content="Изменить дату" Width="130" Height="30" Background="#70B2AF" Click="ButtonSaveDate_Click"/>
                    <Button Content="Удалить позицию" Width="150" Height="30" Margin="8,0,0,0" Click="ButtonDeleteLine_Click"/>
                </WrapPanel>

                <TextBlock Text="Добавить товар в заказ:" Margin="0,15,0,8"/>

                <WrapPanel VerticalAlignment="Center">
                    <ComboBox x:Name="comboStock" Width="580" Height="30" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                    <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="8,0,10,0"/>
                    <TextBox x:Name="txtQuantity" Width="60" Height="28" Text="1" Margin="8,0,10,0" VerticalContentAlignment="Center"/>
                    <Button Content="Добавить позицию" Width="160" Height="30" Background="#D2F6E7" Click="ButtonAddLine_Click"/>
                </WrapPanel>

            </StackPanel>

            <Button Content="Назад" Width="90" Height="34" HorizontalAlignment="Right" Margin="0,10,0,0" Click="ButtonBack_Click"/>
        </StackPanel>
    </Grid>
</Window>