<Window x:Class="prob.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="560" Width="800"
        Icon="Images/icon/Чудо Обувь.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="#D2F6E7">
            <TextBlock Text="Заказы" FontSize="24" VerticalAlignment="Center" Margin="15,0,0,0" />
        </Grid>

        <DataGrid x:Name="gridOrders" Grid.Row="1" Margin="10" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заказа" Binding="{Binding Id}" Width="100" />
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding DateText}" Width="150" />
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding ClientName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Состав заказа" Width="140" Height="34" Background="#70B2AF"
                    Click="ButtonView_Click" />
            <Button Content="Удалить заказ" Width="140" Height="34" Margin="8,0,0,0"
                    Click="ButtonDelete_Click" />
            <Button Content="Назад" Width="90" Height="34" Margin="8,0,0,0" Click="ButtonBack_Click" />
        </StackPanel>
    </Grid>
</Window>
