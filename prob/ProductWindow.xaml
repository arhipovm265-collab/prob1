<Window x:Class="prob.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="640" Width="820"
        Icon="Images/icon/Чудо Обувь.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Calibri" FontSize="14" Background="White">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Image x:Name="imagePhoto" VerticalAlignment="Top" Stretch="Uniform" />

        <Border Grid.Column="1" Margin="15,0,0,0" Padding="15" Background="#D2F6E7">
            <StackPanel>
                <TextBlock x:Name="textManufacturer" />
                <TextBlock x:Name="textName" FontSize="22" TextWrapping="Wrap" />
                <TextBlock x:Name="textCategory" Margin="0,3,0,0" />
                <TextBlock x:Name="textPrice" FontSize="20" Margin="0,8,0,8" />
                <TextBlock x:Name="textComposition" TextWrapping="Wrap" />
                <TextBlock x:Name="textDescription" TextWrapping="Wrap" Margin="0,6,0,6" />
                <TextBlock x:Name="textSizeRange" />

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="Размер:" VerticalAlignment="Center" />
                    <ComboBox x:Name="comboSizes" Width="90" Margin="8,0,0,0"
                              SelectionChanged="ComboSizes_SelectionChanged" />
                    <TextBlock x:Name="textAvailable" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Количество пар:" VerticalAlignment="Center" />
                    <TextBox x:Name="textQuantity" Width="60" Height="26" Margin="8,0,0,0" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="textHint" Foreground="Red" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="Добавить в заказ" Width="150" Height="34" Background="#70B2AF"
                            Click="ButtonAdd_Click" />
                    <Button Content="Назад" Width="90" Height="34" Margin="10,0,0,0" Click="ButtonBack_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
